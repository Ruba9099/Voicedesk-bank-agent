# Copy to .env and fill in. NEVER commit a real .env.

APP_NAME="VoiceDesk Bank Agent"
BANK_NAME="Demo National Bank"
BANK_PHONE="+92-42-111-000-000"      # fictional demo helpline
DEMO_MODE=true

# SQLite for local/demo. MySQL example:
#   mysql+pymysql://voicedesk:CHANGE_ME@db:3306/voicedesk
DATABASE_URL=sqlite:///./voicedesk.db

# Generate strong values:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me
CNIC_PEPPER=change-me-pepper

SEED_DEMO_DATA=true
CORS_ORIGINS=*

# Routing
RING_TIMEOUT_SECONDS=20
SWEEP_INTERVAL_SECONDS=1

# Security policy
MAX_AUTH_ATTEMPTS_PER_CALL=3
MAX_FAILED_ATTEMPTS_PER_CUSTOMER=5
LOCKOUT_MINUTES=15

# Telephony (optional, Twilio-compatible webhook)
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=
OPERATOR_DIAL_NUMBER=
